# Copy to .env.production on the VPS:  cp .env.example .env.production
# Local development needs none of this — `npm run dev` works with defaults.

# Public origin. This is what makes OG image URLs absolute, so link previews
# render in WhatsApp, iMessage and Twitter. Must include the scheme and match
# the domain nginx serves, with no trailing slash.
SOON_SITE_URL=https://soon.example.com

# Container timezone. Only affects log timestamps — countdowns store a UTC
# instant plus their creator's own timezone.
TZ=Europe/Amsterdam

# Where the SQLite file lives. docker-compose.prod.yml already sets this to the
# mounted volume, so leave it unset unless you are running outside Docker.
# SOON_DB_PATH=/data/soon.db
